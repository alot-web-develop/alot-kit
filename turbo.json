{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["PNPM_STORE_DIR", "PNPM_PACKAGE_IMPORT_METHOD"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "outputs": []
    }
  }
}
