{
  "kind": "composite",
  "framework": "react",
  "description": "Compound component built from @alot-web-develop/ui primitives",
  "prefix": "alot-composite",
  "scope": "typescriptreact",
  "requiresFeature": true,
  "role": ["app"],
  "files": [
    { "src": "__Name__.tsx", "dest": "{paths.features}/{feature}/components/__Name__.tsx", "snippet": true }
  ],
  "next": ["subcomponent"]
}
