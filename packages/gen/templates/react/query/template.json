{
  "kind": "query",
  "framework": "react",
  "description": "TanStack Query hooks (list + detail) for an entity",
  "prefix": "alot-query",
  "scope": "typescript",
  "requiresFeature": false,
  "role": ["app"],
  "files": [
    { "src": "useGet__Name__.ts", "dest": "{paths.api}/queries/useGet__Name__.ts", "snippet": true },
    { "src": "useList__Names__.ts", "dest": "{paths.api}/queries/useList__Names__.ts", "unlessFlag": "parent" },
    { "src": "parent.ts", "dest": "{paths.api}/queries/useList__Names__.ts", "flag": "parent" }
  ],
  "next": ["mutation"]
}
