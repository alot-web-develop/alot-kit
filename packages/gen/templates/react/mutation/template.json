{
  "kind": "mutation",
  "framework": "react",
  "description": "TanStack mutations (create/update/delete) with key invalidation",
  "prefix": "alot-mutation",
  "scope": "typescript",
  "requiresFeature": false,
  "role": ["app"],
  "files": [
    { "src": "useCreate__Name__.ts", "dest": "{paths.api}/mutations/useCreate__Name__.ts", "snippet": true, "unlessFlag": "parent" },
    { "src": "parent.ts", "dest": "{paths.api}/mutations/useCreate__Name__.ts", "flag": "parent" },
    { "src": "useUpdate__Name__.ts", "dest": "{paths.api}/mutations/useUpdate__Name__.ts" },
    { "src": "useDelete__Name__.ts", "dest": "{paths.api}/mutations/useDelete__Name__.ts" }
  ],
  "next": ["form"]
}
